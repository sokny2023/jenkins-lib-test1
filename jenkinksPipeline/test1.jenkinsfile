@Library('jenlib@main') _

pipeline {
    agent any

    stages {

        stage('Clone Repo') {
            steps {
                git branch: 'main', url: 'https://github.com/sokny2023/snake-game.git'
            }
        }

        stage('Check Node Version') {
            steps {
                sh 'node --version'
            }
        }

        stage('List Files') {
            steps {
                sh 'ls -la'
            }
        }

        stage('Write Dockerfile') {
            steps {
                script {
                    // Write the Dockerfile for an HTML project
                    writeFile file: 'Dockerfile', text: '''
                    # Use the official Nginx image as a base image
                    FROM nginx:alpine

                    # Copy your HTML files to the Nginx default directory
                    COPY . /usr/share/nginx/html

                    # Expose port 80 to make the server accessible
                    EXPOSE 80
                    '''
                }
            }
        }

        stage('Run Tests') {
            steps {
                sh 'ls -lrt'
            }
        }

        stage('Check Docker and Disk Space') {
            steps {
                sh '''
                df -h
                docker info
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    def repoName = 'snake-game'
                    def imageName = "${repoName}:latest"

                    // Build the Docker image
                    sh "docker build -t ${imageName} ."
                }
            }
        }

        stage('Run Docker Container') {
            steps {
                script {
                    def containerName = 'snake-game-container'

                    // Stop and remove any previous containers with the same name
                    sh '''
                    if [ "$(docker ps -aq -f name=snake-game-container)" ]; then
                        docker rm -f snake-game-container
                    fi
                    '''
                    
                    // Run the container on port 9001 and map it to port 80 inside the container
                    sh "docker run -d --name ${containerName} -p 9001:80 snake-game:latest"
                }
            }
        }

        stage('Check Running Container') {
            steps {
                sh 'docker ps'
            }
        }

        stage('Check Public IP and Port') {
            steps {
                script {
                    def publicIp = sh(script: "curl -s ifconfig.me", returnStdout: true).trim()
                    echo "Application is running at: http://${publicIp}:9001"
                }
            }
        }

        stage('Configure Domain and HTTPS') {
            steps {
                // script {
                //     // Write the Nginx configuration for your domain
                //     writeFile file: '/etc/nginx/sites-available/snake-game.devkh.asia', text: '''
                //     server {
                //         listen 80;
                //         server_name snake-game.devkh.asia;

                //         location / {
                //             proxy_pass http://localhost:9001/;
                //             proxy_set_header Host $host;
                //             proxy_set_header X-Real-IP $remote_addr;
                //             proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                //             proxy_set_header X-Forwarded-Proto $scheme;
                //         }
                //     }
                //     '''
                    
                //     // Enable the site by creating a symlink to sites-enabled
                //     sh '''
                //     ln -s /etc/nginx/sites-available/snake-game.devkh.asia /etc/nginx/sites-enabled/
                //     nginx -t  # Test Nginx configuration
                //     systemctl reload nginx  # Reload Nginx to apply the new configuration
                //     '''

                //     // Obtain SSL certificate using Certbot
                //     sh '''
                //     certbot --nginx -d snake-game.devkh.asia
                //     systemctl reload nginx
                //     '''
                // }

                sh '''
                    sudo touch /etc/nginx/sites-available/snake-game.devkh.asia
                    sudo chmod 777 /etc/nginx/sites-available/snake-game.devkh.asia
                    echo """ 
                    server {
                        listen 80;
                        server_name test01.devkh.asia;

                        location / {
                            proxy_pass http://localhost:9001/;
                            proxy_set_header Host $host;
                            proxy_set_header X-Real-IP $remote_addr;
                            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                            proxy_set_header X-Forwarded-Proto $scheme;
                        }
                    }
                    """ >> /etc/nginx/sites-available/snake-game.devkh.asia
                    sudo ls -l /etc/nginx/sites-available/

                    sudo ln -s /etc/nginx/sites-available/snake-game.devkh.asia /etc/nginx/sites-enabled/
                    sudo certbot --nginx --email soknyhacker@example.com --agree-tos --no-eff-email -d snake-game.devkh.asia

                    sudo systemctl reload nginx

                '''
                script{
                    echo " ----- Welcome to the snake game ------"
                    echo "  http://snake-game.devkh.asia"
                }
            }
        }
    }

    post {
        always {
            cleanWs() // Clean workspace after the job
        }
    }
}