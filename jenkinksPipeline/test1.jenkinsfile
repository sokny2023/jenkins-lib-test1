@Library('jenlib@main') _

pipeline {
    agent any

    parameters {
        string(name: 'PORT', defaultValue: '9001', description: 'Port to run the container on')
        string(name: 'DOMAIN_NAME', defaultValue: 'snake-game.devkh.asia', description: 'Domain name for the application')
    }

    stages {

        stage('Clone Repo') {
            steps {
                git branch: 'main', url: 'https://github.com/sokny2023/snake-game.git'
            }
        }

        stage('Check Node Version') {
            steps {
                sh 'node --version'
            }
        }

        stage('List Files') {
            steps {
                sh 'ls -la'
            }
        }

        stage('Write Dockerfile') {
            steps {
                script {
                    // Write the Dockerfile for an HTML project
                    writeFile file: 'Dockerfile', text: '''
                    # Use the official Nginx image as a base image
                    FROM nginx:alpine

                    # Copy your HTML files to the Nginx default directory
                    COPY . /usr/share/nginx/html

                    # Expose port 80 to make the server accessible
                    EXPOSE 80
                    '''
                }
            }
        }

        stage('Run Tests') {
            steps {
                sh 'ls -lrt'
            }
        }

        stage('Check Docker and Disk Space') {
            steps {
                sh '''
                df -h
                docker info
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    def repoName = 'snake-game'
                    def imageName = "${repoName}:latest"

                    // Build the Docker image
                    sh "docker build -t ${imageName} ."
                }
            }
        }

        stage('Run Docker Container') {
            steps {
                script {
                    def containerName = 'snake-game-container'

                    // Stop and remove any previous containers with the same name
                    sh '''
                    if [ "$(docker ps -aq -f name=snake-game-container)" ]; then
                        docker rm -f snake-game-container
                    fi
                    '''
                    
                    // Run the container using the specified port
                    sh "docker run -d --name ${containerName} -p ${PORT}:80 snake-game:latest"
                }
            }
        }

        stage('Check Running Container') {
            steps {
                sh 'docker ps'
            }
        }

        stage('Check Public IP and Port') {
            steps {
                script {
                    def publicIp = sh(script: "curl -s ifconfig.me", returnStdout: true).trim()
                    echo "Application is running at: http://${publicIp}:${PORT}"
                }
            }
        }

        stage('Configure Domain and HTTPS') {
            steps {
                script {
                    // Write Nginx configuration dynamically based on domain name
                    def nginxConfig = """
                    server {
                        listen 80;
                        server_name ${DOMAIN_NAME};

                        location / {
                            proxy_pass http://localhost:${PORT}/;
                            proxy_set_header Host \$host;
                            proxy_set_header X-Real-IP \$remote_addr;
                            proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
                            proxy_set_header X-Forwarded-Proto \$scheme;
                        }
                    }
                    """
                    writeFile file: "/etc/nginx/sites-available/${DOMAIN_NAME}", text: nginxConfig

                    // Enable the site and reload Nginx
                    sh '''
                    sudo ln -s /etc/nginx/sites-available/${DOMAIN_NAME} /etc/nginx/sites-enabled/
                    sudo certbot --nginx --email soknyhacker@example.com --agree-tos --no-eff-email -d ${DOMAIN_NAME}
                    sudo systemctl reload nginx
                    '''
                }
                script {
                    echo "----- Welcome to the snake game -----"
                    echo "Application running at: http://${DOMAIN_NAME}"
                }
            }
        }
    }

    post {
        always {
            cleanWs() // Clean workspace after the job
        }
    }
}
