pipeline {
    agent any

    parameters {
        string(name: 'PORT', defaultValue: '9001', description: 'Port to run the container on')
        string(name: 'DOMAIN_NAME', defaultValue: '.devkh.asia', description: 'Domain name for the application')
        string(name: 'CONTAINER_NAME', defaultValue: 'container1', description: 'Name of the Docker container')
        choice(name: 'ACTION', choices: ['build', 'rebuild'], description: 'Choose whether to build or rebuild')
    }

    stages {

        stage('Clone Repo') {
            steps {
                git branch: 'main', url: 'https://github.com/sokny2023/snake-game.git'
            }
        }

        stage('Check Node Version') {
            steps {
                sh 'node --version'
            }
        }

        stage('List Files') {
            steps {
                sh 'ls -la'
            }
        }

        stage('Write Dockerfile') {
            steps {
                script {
                    // Write the Dockerfile for an HTML project
                    writeFile file: 'Dockerfile', text: '''
                    # Use the official Nginx image as a base image
                    FROM nginx:alpine

                    # Copy your HTML files to the Nginx default directory
                    COPY . /usr/share/nginx/html

                    # Expose port 80 to make the server accessible
                    EXPOSE 80
                    '''
                }
            }
        }

        stage('Run Tests') {
            steps {
                sh 'ls -lrt'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    def repoName = 'snake-game'
                    def imageName = "${repoName}:latest"

                    // Build the Docker image
                    sh "docker build -t ${imageName} ."
                }
            }
        }

        stage('Run Docker Container') {
            steps {
                script {
                    // Stop and remove any previous containers with the same name
                    sh '''
                    if [ "$(docker ps -aq -f name=${CONTAINER_NAME})" ]; then
                        docker rm -f ${CONTAINER_NAME}
                    fi
                    '''
                    
                    // Run the container using the specified port
                    sh "docker run -d --name ${CONTAINER_NAME} -p ${PORT}:80 snake-game:latest"
                }
            }
        }

        stage('Check Running Container') {
            steps {
                sh 'docker ps'
            }
        }

        stage('Check Public IP and Port') {
            steps {
                script {
                    def publicIp = sh(script: "curl -s ifconfig.me", returnStdout: true).trim()
                    echo "Application is running at: http://${publicIp}:${PORT}"
                }
            }
        }

        stage('Configure Domain and HTTPS') {
            when {
                expression { params.ACTION == 'build' }
            }
            steps {
                script {
                    // Write Nginx configuration dynamically based on the domain name
                    def nginxConfig = """
                    server {
                        listen 80;
                        server_name ${DOMAIN_NAME};

                        location / {
                            proxy_pass http://localhost:${PORT}/;
                            proxy_set_header Host \\\"\\\$host\\\";
                            proxy_set_header X-Real-IP \\\"\\\$remote_addr\\\";
                            proxy_set_header X-Forwarded-For \\\"\\\$proxy_add_x_forwarded_for\\\";
                            proxy_set_header X-Forwarded-Proto \\\"\\\$scheme\\\";
                        }
                    }
                    """

                    // Use sudo to write the Nginx config file
                    sh """
                    sudo bash -c 'echo "${nginxConfig}" > /etc/nginx/sites-available/${DOMAIN_NAME}'
                    sudo ln -sf /etc/nginx/sites-available/${DOMAIN_NAME} /etc/nginx/sites-enabled/${DOMAIN_NAME}
                    sudo nginx -t  # Test the Nginx configuration
                    sudo systemctl reload nginx  # Reload Nginx to apply the new configuration
                    """
                }
            }
        }

        stage('Enable SSL with Certbot') {
            when {
                expression { params.ACTION == 'build' }
            }
            steps {
                script {
                    // Use Certbot to automatically obtain an SSL certificate
                    sh """
                    sudo certbot --nginx --email soknyhacker@example.com --agree-tos --no-eff-email -d ${DOMAIN_NAME}
                    sudo systemctl reload nginx
                    """
                }
            }
        }

        stage('Display Application URL') {
            steps {
                script {
                    def protocol = (params.ACTION == 'build') ? 'https' : 'http'
                    echo "----- Welcome to the snake game -----"
                    echo "Application running at: ${protocol}://${DOMAIN_NAME}"
                }
            }
        }
    }

    post {
        always {
            cleanWs() // Clean workspace after the job
        }
    }
}
